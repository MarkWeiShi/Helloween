{
  "name": "boo-around-the-world",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch server/index.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "build": "npm run build:sdk && npm run build:web",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "assets": "node scripts/prepare-assets.mjs",
    "assets:transformations": "node scripts/prepare-transformations.mjs",
    "check:content": "node scripts/check-content.mjs",
    "loadtest": "node scripts/loadtest.mjs",
    "backup": "node scripts/backup.mjs",
    "publish:assets": "node scripts/publish-assets.mjs",
    "assets:previews": "node scripts/prepare-globe-previews.mjs",
    "check:locales": "node scripts/check-locales.mjs",
    "check:layout": "node scripts/audit-locale-layout.mjs",
    "build:sdk": "tsc -p packages/ghost-sdk/tsconfig.json && node scripts/package-sdk.mjs",
    "build:web": "tsc --noEmit && vite build",
    "build:api": "node scripts/build-api.mjs",
    "build:all": "npm run build && npm run build:api",
    "test:split": "REQUIRE_NGINX=1 node --test tests/split-deployment.test.mjs",
    "pretest": "npm run build:sdk",
    "predev": "node scripts/prepare-content.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "geoip-country": "5.0.202610310241"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.5",
    "rolldown": "1.2.15",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "d3-geo": "^3.1.1"
  }
}
