PORT=8787
HOST=127.0.0.1
DATABASE_PATH=.data/boo.sqlite
# External website origin (Vite development uses port 5173).
PUBLIC_ORIGIN=http://localhost:5173
# Enable only behind a protected ingress that overwrites X-Real-IP.
TRUST_PROXY=false
# Optional bounded JSON process metrics; 0 disables periodic logging.
METRICS_INTERVAL_MS=0
BACKUP_BUCKET=
BACKUP_ENDPOINT=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
MEDIA_BUCKET=
AWS_ENDPOINT_URL_S3=
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Public SDK key (not the Kakao Admin or REST secret). Configure Web domain in Kakao Developers.
KAKAO_JAVASCRIPT_KEY=
# Server only. Register /api/kakao/share-webhook in Kakao Developers before enabling.
# Never use a VITE_ prefix or expose this key in public config.
KAKAO_ADMIN_KEY=
KAKAO_SHARE_WEBHOOK_ENABLED=false
# Keep the WeChat App Secret server-side. Configure JS API domain and server IP allowlist.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Public Meta App ID for desktop Messenger Send Dialog; not an App Secret.
FACEBOOK_APP_ID=1125720033691224
# Account authentication: Supabase project URL and publishable (or legacy anon) key.
# Enable the selected providers + email OTP in Supabase. Never use service_role here.
# X OAuth 2.0 uses AUTH_PROVIDERS=x (not legacy twitter).
# Add facebook,kakao,line only after configuring and enabling each provider.
# line maps to custom:line (OAuth2); kakao maps to custom:kakao (OIDC, no email scope).
# Provider secrets belong in Supabase, never frontend environment variables.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
AUTH_PROVIDERS=google

# Public LINE LIFF identifier; never put the Channel secret in the browser.
LINE_LIFF_ID=

# X offline renewal; OAuth client must match the X app configured in Supabase.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Base64-encoded 32 random bytes. Keep stable in deployment secrets, out of Git.
X_TOKEN_ENCRYPTION_KEY=

# First play opens the HelloTalk link once and persists playback access.
# When enabled but misconfigured, access stays locked (fails closed).
BRANCH_UNLOCK_ENABLED=true
BRANCH_UNLOCK_LINK=https://brc.hellotalk.com/Helloween2026
# No webhook secret is needed for the first-play redirect.

# Optional build-time public media CDN; upload matching immutable release first.
PUBLIC_ASSET_ORIGIN=
