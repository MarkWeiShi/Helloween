PORT=8787
HOST=127.0.0.1
DATABASE_PATH=.data/boo.sqlite
# External website origin (Vite development uses port 5173).
PUBLIC_ORIGIN=http://localhost:5173
# Enable only behind a protected ingress that overwrites X-Real-IP.
TRUST_PROXY=false
# Optional bounded JSON process metrics; 0 disables periodic logging.
METRICS_INTERVAL_MS=0
INVITE_REWARDS_ENABLED=true
BACKUP_BUCKET=
BACKUP_ENDPOINT=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
MEDIA_BUCKET=
AWS_ENDPOINT_URL_S3=
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Public SDK key (not the Kakao Admin or REST secret). Configure Web domain in Kakao Developers.
KAKAO_JAVASCRIPT_KEY=
# Keep the WeChat App Secret server-side. Configure JS API domain and server IP allowlist.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Public Meta App ID for desktop Messenger Send Dialog; not an App Secret.
FACEBOOK_APP_ID=
# Account authentication: Supabase project URL and publishable (or legacy anon) key.
# Enable Google + email OTP in Supabase. Never use service_role here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
AUTH_PROVIDERS=google
