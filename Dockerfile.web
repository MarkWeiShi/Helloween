FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG PUBLIC_ORIGIN
ENV PUBLIC_ORIGIN=$PUBLIC_ORIGIN
RUN npm run build && npm run check:content

FROM nginx:stable-alpine
COPY --from=build /app/dist/ /usr/share/nginx/html/
COPY deploy/nginx/static.conf /etc/nginx/conf.d/default.conf
COPY deploy/nginx/security.conf /etc/nginx/ghost-security.conf
COPY deploy/nginx/cache.conf /etc/nginx/conf.d/00-cache.conf
EXPOSE 80
